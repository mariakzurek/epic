    <!-- DR_Lead: Pb absorber matrix
         Ported from DRsimMaterials.cc:65 (fPb).
         Pure elemental lead, density 11.35 g/cm3.
         No optical properties: opaque matrix. Photons reaching the Pb boundary
         from a fiber core are handled by the fiber outer-skin surface (plugin, P2-beta).
         Note: epic already defines "Pb"; DR_Lead is an isolated copy to avoid
         any future property contamination from changes to the epic base entry.
    -->
    <material name="DR_Lead">
      <!-- Ported from DRsimMaterials.cc:65 -->
      <D type="density" value="11.35" unit="g/cm3"/>
      <composite n="1" ref="Pb"/>
    </material>

    <!-- DR_Polystyrene: SCSF-78 scintillating fiber core (S-channel)
         Ported from DRsimMaterials.cc:81-83 (composition) and 140-168 (optical).
         Composition: C8H8, density 1.05 g/cm3.

         Birks constant syntax: <constant name="BirksConstant" value="0.126*mm/MeV"/>
         Confirmed against epic/compact/materials.xml:495 (SciFiPb_Scintillator),
         which reads: <constant name="BirksConstant" value="0.126*mm/MeV"/>
         Units: mm/MeV.  Source: DRsimMaterials.cc:168 (0.126*mm/MeV).
         This satisfies plan R10 Birks sub-check.

         SCINTILLATIONYIELD: source line 158 = 10./keV = 10000 photons/MeV.
         DD4hep: use <constant name="SCINTILLATIONYIELD" value="10000.0/MeV"/>
         (scalar constant, not a wavelength table — must be <constant> not <property>).
         In Geant4 11: SCINTILLATIONYIELD (no suffix) = total yield.
         SCINTILLATIONYIELD1/2/3 = relative channel fractions (not the total).
         SCINTILLATIONCOMPONENT1 = emission spectrum table (correctly a <property>).
         SCINTILLATIONTIMECONSTANT1 = fast decay time (scalar <constant>).
         RESOLUTIONSCALE = resolution scale (scalar <constant>).
    -->
    <material name="DR_Polystyrene">
      <!-- Ported from DRsimMaterials.cc:81-168 -->
      <D type="density" value="1.05" unit="g/cm3"/>
      <composite n="8" ref="C"/>
      <composite n="8" ref="H"/>
      <property name="RINDEX"                    ref="RINDEX__DR_Polystyrene"/>
      <property name="ABSLENGTH"                 ref="ABSLENGTH__DR_Polystyrene"/>
      <property name="SCINTILLATIONCOMPONENT1"   ref="SCINTILLATIONCOMPONENT1__DR_Polystyrene"/>
      <!-- Scintillation constants, following leadtungsten_optical idiom -->
       <constant name="SCINTILLATIONYIELD"          value="10000.0/MeV"/>
      <constant name="SCINTILLATIONYIELD1"         value="1.0"/>
      <constant name="SCINTILLATIONTIMECONSTANT1"  value="2.8*ns"/>
      <constant name="RESOLUTIONSCALE"             value="1.0"/>
      <!-- Birks quenching constant.
           Syntax: <constant name="BirksConstant" value="..."/> per
           epic/compact/materials.xml:495 (SciFiPb_Scintillator).
           Units: mm/MeV.  Source: DRsimMaterials.cc:168.
           SCINTILLATIONYIELD uses <constant> not <property> (scalar, not wavelength table).
           Name is SCINTILLATIONYIELD (no suffix) = total yield per Geant4 11 API.
           SCINTILLATIONYIELD1 is a relative channel fraction, NOT the total yield.
           SCINTILLATIONCOMPONENT1 (the emission spectrum table) is already defined above
           as a <property> with coldim=2 — that is correct for a wavelength table. -->
      <constant name="BirksConstant" value="0.126*mm/MeV"/>
    </material>

