<!--
  DR Prototype sub-compact variant: S:C = 2:1 (33% C fraction)
  Included by epic_dr_prototype_2x1.xml.
-->
<lccdd>
  <define>
    <constant name="DR_module_dx"              value="200.0*mm"/>
    <constant name="DR_module_dy"              value="200.0*mm"/>
    <constant name="DR_module_dz"              value="1000.0*mm"/>
    <constant name="DR_fiber_od"               value="1.0*mm"/>
    <constant name="DR_fiber_pitch_x"          value="1.35*mm"/>
    <constant name="DR_fiber_pitch_y"          value="1.22*mm"/>
    <constant name="DR_sipm_window_thickness"  value="0.1*mm"/>
    <constant name="DR_sipm_window_gap"        value="0.05*mm"/>
    <constant name="DR_sc_ratio_S"             value="2"/>
    <constant name="DR_sc_ratio_C"             value="1"/>
    <constant name="DRPrototype_ID"            value="200"/>
  </define>
  <detectors>
    <detector
      id="DRPrototype_ID"
      name="DRPrototype"
      type="epic_DRPrototype"
      readout="DRPrototypeHits"
      sc_ratio_S="2"
      sc_ratio_C="1"
      vis_absorber="DR_PbAbsorberVis"
      vis_s_fiber="DR_ScintFiberVis"
      vis_c_fiber="DR_CherFiberVis"
      vis_cladding="DR_FiberCladdingVis"
      vis_sipm="DR_SiPMWindowVis"
      calorimeterType="EM"
      >
      <dimensions
        dx="DR_module_dx"
        dy="DR_module_dy"
        dz="DR_module_dz"
        fiber_od="DR_fiber_od"
        fiber_pitch_x="DR_fiber_pitch_x"
        fiber_pitch_y="DR_fiber_pitch_y"
        sipm_window_thickness="DR_sipm_window_thickness"
        sipm_window_gap="DR_sipm_window_gap"
        />
      <sensors>
        <sipm material="AirOptical" surface="DR_SiPMSurf"/>
      </sensors>
    </detector>
  </detectors>
  <readouts>
    <readout name="DRPrototypeHits">
      <id>system:8,fiber:16,end:1,channel:1</id>
    </readout>
  </readouts>

  <display>
    <vis name="DR_PbAbsorberVis" r="0.45" g="0.47" b="0.50" alpha="0.22" drawingStyle="solid" showDaughters="true" visible="true"/>
    <vis name="DR_ModuleEnvelopeVis" r="0.70" g="0.72" b="0.75" alpha="0.12" drawingStyle="solid" showDaughters="true" visible="true"/>
    <vis name="DR_ScintFiberVis" r="1.00" g="0.72" b="0.05" alpha="0.95" drawingStyle="solid" showDaughters="true" visible="true"/>
    <vis name="DR_CherFiberVis" r="0.00" g="0.55" b="1.00" alpha="0.95" drawingStyle="solid" showDaughters="true" visible="true"/>
    <vis name="DR_FiberCladdingVis" r="0.85" g="0.90" b="0.95" alpha="0.18" drawingStyle="solid" showDaughters="true" visible="true"/>
    <vis name="DR_SiPMWindowVis" r="0.85" g="0.15" b="1.00" alpha="0.45" drawingStyle="solid" showDaughters="true" visible="true"/>
    <vis name="DR_InvisibleVis" visible="false" showDaughters="true"/>
  </display>
</lccdd>
